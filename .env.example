# Copy to .env and fill in real values before `docker compose up`.
#
# ---------------------------------------------------------------------------
# REQUIRED: A real, reachable Casdoor instance.
# ---------------------------------------------------------------------------
# docker-compose.yml runs the gateway with SPRING_PROFILES_ACTIVE=casdoor,
# which triggers OAuth2ClientConfig#casdoorClientRegistrationRepository to
# fetch ${CASDOOR_ISSUER_URI}/.well-known/openid-configuration at startup.
# If the URL is unreachable, the app fails to start. There is deliberately
# no mock OIDC server bundled in this compose file; the design is that
# production and local dev both point at the real Casdoor instance (likely
# deployed in an adjacent Kubernetes cluster).
#
# For iterating on code without a Casdoor instance, run the gateway with
# SPRING_PROFILES_ACTIVE=local instead (e.g. from the IDE). That profile
# registers a structural-only mock client — actual login flows won't complete
# but the app starts and route/DB/actuator behavior can be exercised.
#
# Note: CASDOOR_ISSUER_URI must be reachable from INSIDE the gateway container.
# If your Casdoor lives on your host (e.g. http://localhost:8000/), rewrite
# it as http://host.docker.internal:8000/ and add the following to the gateway
# service definition in docker-compose.yml:
#     extra_hosts:
#       - "host.docker.internal:host-gateway"
# ---------------------------------------------------------------------------

# Postgres admin + replication credentials.
POSTGRES_ADMIN_PASSWORD=change-me-admin
POSTGRES_REPLICATION_PASSWORD=change-me-replication

# SELECT-only role the gateway authenticates as via R2DBC.
GATEWAY_READER_PASSWORD=change-me-reader

# Real Casdoor — REPLACE THESE. Discovery endpoint is fetched at startup.
CASDOOR_ISSUER_URI=https://your-casdoor-host.example.com/
CASDOOR_CLIENT_ID=replace-with-real-client-id
CASDOOR_CLIENT_SECRET=replace-with-real-client-secret

# How often the gateway re-queries Postgres for routes (Duration, e.g. 30s, 1m).
GATEWAY_ROUTES_REFRESH_INTERVAL=30s
