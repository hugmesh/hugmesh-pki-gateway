<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
  <changeSet id="seed-pki-routes" author="snapdragon">
    <insert tableName="gateway_routes">
      <column name="route_id" value="casdoor-auth"/>
      <column name="uri" value="http://casdoor.snapdragon-pki.svc.cluster.local:8000"/>
      <column name="predicates" value="Path=/api/auth/**"/>
    </insert>
    <insert tableName="gateway_routes">
      <column name="route_id" value="casdoor-login"/>
      <column name="uri" value="http://casdoor.snapdragon-pki.svc.cluster.local:8000"/>
      <column name="predicates" value="Path=/login/**"/>
    </insert>
    <insert tableName="gateway_routes">
      <column name="route_id" value="casdoor-oidc"/>
      <column name="uri" value="http://casdoor.snapdragon-pki.svc.cluster.local:8000"/>
      <column name="predicates" value="Path=/.well-known/**"/>
    </insert>
    <insert tableName="gateway_routes">
      <column name="route_id" value="headscale"/>
      <column name="uri" value="http://headscale.snapdragon-pki.svc.cluster.local:8080"/>
      <column name="predicates" value="Host=scale.snapdragon.systems"/>
    </insert>
  </changeSet>
</databaseChangeLog>
